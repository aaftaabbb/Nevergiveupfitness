# ---------------------------------------------------------------------------
# Never Give Up Fitness - environment variables
# Copy this file to .env.local (local development) and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# MongoDB Atlas free tier connection string.
# Atlas -> Cluster -> Connect -> Drivers -> Node.js
# The database name can live in the URI path...
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/never-give-up-fitness?retryWrites=true&w=majority
MONGODB_URI=

# ...or be set here. This wins over the path in the URI, which keeps
# authSource=admin working when the connection string has no database path.
MONGODB_DB=never-give-up-fitness

# Secret used to sign the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this logs the owner out everywhere, so keep it stable.
SESSION_SECRET=

# Credentials created by `npm run seed`. Change ADMIN_PASSWORD before seeding
# a real gym, and delete both lines afterwards so the value is not in git.
ADMIN_USERNAME=rahul
ADMIN_PASSWORD=ChangeThisBeforeSeeding123!

# Public site URL, used for canonical tags, sitemap and Open Graph images.
# Leave blank locally; set to your Vercel domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
